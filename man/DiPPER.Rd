# Run DiPPER
# Note: niter = 400, chains = 1 and cores = 1 are used here for speed.
# In real applications, use higher values (e.g. the default niter = 2000,
# chains = 4, and cores = 4).
fit <- dipper(
  tse = tse_hintikka,
  formula = ~ Fat + XOS,
  assay.type = "counts",
  niter = 400,
  chains = 1,
  cores = 1
)

# Print the model fit summary
print(fit)

# Summarize the results
res <- summary(fit)
head(res)
}
