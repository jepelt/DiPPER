Package: DiPPER
Title: A Bayesian Hierarchical Approach to Differential Prevalence Analysis
Version: 0.1.0
Authors@R: c(
    person(given = "Juho",
           family = "Pelto",
           role = c("aut", "cre"),
           email = "jepelt@utu.fi",
           comment = c(ORCID = "0000-0001-8820-8014")),
